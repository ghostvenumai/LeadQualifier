# =============================================================================
# LeadQualifier AI - Umgebungsvariablen Vorlage
# GhostVenumAI | April 2026
# =============================================================================
#
# ANLEITUNG:
# 1. Diese Datei als ".env" kopieren: cp .env.example .env
# 2. Alle Werte mit echten Credentials ersetzen
# 3. .env NIEMALS in Git committen (ist in .gitignore eingetragen)
# 4. .env NIEMALS an Dritte weitergeben
#
# =============================================================================


# =============================================================================
# ANTHROPIC / CLAUDE AI
# =============================================================================

# Anthropic API Key - Pflichtfeld!
# Erhalten unter: https://console.anthropic.com/
# Format: sk-ant-api03-...
ANTHROPIC_API_KEY=

# Optional: Abweichende Modelle (Defaults werden empfohlen)
# Writer Agent nutzt Opus fuer beste E-Mail-Qualitaet
# CLAUDE_WRITER_MODEL=claude-opus-4-6
# CLAUDE_AGENT_MODEL=claude-sonnet-4-6


# =============================================================================
# SLACK INTEGRATION
# =============================================================================

# Slack Incoming Webhook URL fuer qualifizierte Lead-Alerts
# Erstellen unter: https://api.slack.com/apps -> Incoming Webhooks
# Optional - wenn leer, werden keine Slack-Benachrichtigungen gesendet
SLACK_WEBHOOK_URL=

# AES-256-GCM Verschluesselungskey fuer Slack-Payloads (32 Bytes als Hex)
# Generieren mit: python -c "import secrets; print(secrets.token_hex(32))"
# Optional - wenn leer, werden Slack-Nachrichten unverschluesselt gesendet
SLACK_ENCRYPTION_KEY=


# =============================================================================
# GMAIL / E-MAIL VERSAND
# =============================================================================

# Pfad zur Gmail OAuth2 credentials.json Datei
# Erstellen unter: https://console.cloud.google.com/apis/credentials
# Beide Gmail-Variablen muessen gesetzt sein oder beide leer bleiben
GMAIL_CREDENTIALS_JSON=

# Absender-E-Mail-Adresse fuer ausgehende Lead-E-Mails
# Muss mit dem Gmail OAuth2-Konto uebereinstimmen
GMAIL_SENDER_EMAIL=


# =============================================================================
# CRM INTEGRATION
# =============================================================================

# Webhook URL des externen CRM-Systems (z.B. HubSpot, Pipedrive, Salesforce)
# Optional - wenn leer, werden keine CRM-Updates durchgefuehrt
# Beispiel HubSpot: https://api.hubapi.com/crm/v3/objects/contacts
CRM_WEBHOOK_URL=


# =============================================================================
# LIZENZ
# =============================================================================

# LeadQualifier AI Lizenzschluessel
# Erhalten von GhostVenumAI nach dem Kauf
# Wenn leer: Demo-Modus aktiv (max. 10 Leads ODER 14 Tage)
LICENSE_KEY=

# Lizenz-Validierungsserver (Standard nicht aendern ausser auf Anweisung)
# LICENSE_SERVER_URL=https://license.ghostvenumai.de/validate


# =============================================================================
# DATENBANK
# =============================================================================

# SQLite Datenbankpfad (relativ zum Projektroot) oder externe DB-URL
# Standard: SQLite im Projektroot (empfohlen fuer Einzel-Instanz)
# PostgreSQL Beispiel: postgresql://user:password@localhost:5432/leadqualifier
DATABASE_URL=sqlite:///leadqualifier.db


# =============================================================================
# FLASK / WEB SERVER
# =============================================================================

# Flask Secret Key fuer sichere Sessions
# Generieren mit: python -c "import secrets; print(secrets.token_hex(32))"
# PFLICHTFELD in Produktion!
FLASK_SECRET_KEY=

# Shared Secret fuer HMAC-Validierung eingehender Webhook-Requests
# Optional - wenn leer, werden Webhooks ohne Signatur-Check akzeptiert
# SICHERHEITSHINWEIS: In Produktion unbedingt setzen!
WEBHOOK_SECRET=


# =============================================================================
# LOGGING & DEBUG
# =============================================================================

# Log-Level fuer das gesamte System
# Gueltge Werte: DEBUG, INFO, WARNING, ERROR, CRITICAL
# In Produktion: INFO oder WARNING empfohlen
# Im Entwicklung: DEBUG moeglich
LOG_LEVEL=INFO


# =============================================================================
# DEMO-LIMITS (nur relevant wenn LICENSE_KEY leer)
# =============================================================================

# Maximale Anzahl verarbeiteter Leads im Demo-Modus
# Das System deaktiviert sich wenn einer der beiden Grenzwerte erreicht wird
DEMO_MAX_LEADS=10

# Maximale Laufzeit des Demo-Modus in Tagen ab erster Verwendung
DEMO_MAX_DAYS=14


# =============================================================================
# PIPELINE-KONFIGURATION
# =============================================================================

# Mindest-Score fuer qualifizierte Leads (1-10)
# Leads mit Score >= QUALIFY_THRESHOLD erhalten eine Qualifizierungs-E-Mail
# Leads darunter erhalten eine freundliche Ablehnung
QUALIFY_THRESHOLD=7
